{
  "name": "@ctruhtech/verse-mcp",
  "version": "0.1.2",
  "description": "MCP server for Verse Engine: publish 3D scenes, walkthroughs and worlds as links that open in any browser, from Claude, ChatGPT, Cursor or any MCP client. Sign in at https://verse.ctruh.com/mcp, or run locally.",
  "homepage": "https://verse.ctruh.com/docs/#/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-vinayagastya/verse-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/dev-vinayagastya/verse-mcp/issues"
  },
  "author": "Ctruh <hello@ctruh.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "verse-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "mcpName": "com.ctruh.verse/verse",
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/mock.test.mjs",
    "test:integration": "npm run build && node --test test/integration.test.mjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@ctruhtech/verse-sdk": "^4.0.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "3d",
    "gltf",
    "glb",
    "verse",
    "ctruh",
    "ai-agents"
  ],
  "publishConfig": {
    "access": "public"
  }
}
